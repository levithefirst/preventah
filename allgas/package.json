{
  "name": "allgas",
  "version": "1.0.0",
  "private": true,
  "description": "Preventah All Gas - a household prevention loop on Convex.",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "dev:frontend": "vite",
    "build:app": "vite build",
    "build:site": "node scripts/embed-site.mjs",
    "build": "vite build && node scripts/embed-site.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "node --experimental-strip-types --import ./tests/register.mjs --test tests/*.test.ts",
    "deploy": "convex deploy --cmd \"npm run build\" --cmd-url-env-var-name VITE_CONVEX_URL"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
