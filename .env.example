# ---------------------------------------------------------------------------
# Preventah - environment variable NAMES only.
#
# Never put real values in this file. Real values are set directly in the
# Vercel project's Environment Variables dashboard and are read at runtime
# from process.env on the server only.
# ---------------------------------------------------------------------------

# Neon Postgres pooled connection string.
DATABASE_URL=

# Escrow wallet that receives USDT stakes and sends refunds + rewards.
# Public address. Safe to expose to the client, which needs it as the
# transfer recipient.
NEXT_PUBLIC_ESCROW_WALLET_ADDRESS=

# Server-only mirror of the escrow address, used to verify incoming stake
# transactions on-chain. Must match NEXT_PUBLIC_ESCROW_WALLET_ADDRESS.
ESCROW_WALLET_ADDRESS=

# SERVER ONLY. Private key of the escrow wallet, used exclusively by the
# payout job to return stakes and rewards.
# Set this ONLY in the Vercel dashboard. Never commit it, never log it,
# never prefix it with NEXT_PUBLIC_.
ESCROW_PRIVATE_KEY=

# Shared secret guarding the /api/cron/payout endpoint. Vercel Cron sends it
# as the Authorization header.
CRON_SECRET=

# Secret used to sign wallet-auth session cookies (any long random string).
SESSION_SECRET=

# Polygon JSON-RPC endpoint used for reading receipts and broadcasting payouts.
POLYGON_RPC_URL=

# Optional overrides. Defaults target USDT on Polygon mainnet.
# NEXT_PUBLIC_CHAIN_ID=137
# NEXT_PUBLIC_USDT_ADDRESS=
# NEXT_PUBLIC_STAKE_AMOUNT_USDT=0.1
# REWARD_BPS=500
